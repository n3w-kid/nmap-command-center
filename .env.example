# Approved network scope: only targets wholly within these networks can be scanned.
# Example training range: 127.0.0.0/8,192.168.56.0/24
ALLOWED_CIDRS=127.0.0.0/8,::1/128,192.168.56.0/24
ALLOWED_HOSTNAMES=
MAX_TARGETS=256
MAX_DURATION=1800

# Set a long unique administrator secret (16+ characters).
# Use Settings to approve additional authorized scopes and /scripts to approve NSE scripts.
ADMIN_TOKEN=

# Optional higher-risk lab-only scripts: brute, exploit, dos and fuzzer.
# A target MUST be an exact loopback/RFC1918/ULA address on this list, and ALSO
# fall inside ALLOWED_CIDRS. Public IPs and CIDR ranges are not accepted here.
# Requires an admin approval for each script and user confirmation for each scan.
LAB_MODE_ENABLED=false
LAB_ALLOWED_IPS=192.168.56.10
